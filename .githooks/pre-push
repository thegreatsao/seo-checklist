#!/usr/bin/env bash
# Run CI's own steps here before the push spends minutes running them there.
#
# The steps are read out of .github/workflows/ci.yml by tools/ci_local.py, so this
# hook has no list of checks to fall out of step with. It lives in .githooks/ and
# not in .git/hooks/ so that it travels with the tree; `git config core.hooksPath
# .githooks` is what points git at it, and README says so.
#
# Escape hatch: `git push --no-verify`. Use it when you mean to, not when the hook
# is slow — a first run is around ten minutes and an unchanged tree is instant,
# because ci_local.py stamps the tree hash it verified.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
# A linked worktree has no virtualenv of its own: the checkout it was added from has
# the one the suite needs. This tree's own is preferred when it exists. Until 0.137.0
# only this tree was looked in, and a push from a worktree went on to whatever
# `python` the PATH held — on Windows, a stub that is not an interpreter.
main="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
py=""
for home in "$root" "$main"; do
  for candidate in "$home/.venv/Scripts/python.exe" "$home/.venv/bin/python"; do
    if [ -x "$candidate" ]; then
      py="$candidate"
      break 2
    fi
  done
done
[ -n "$py" ] || py="$(command -v python3 || command -v python || true)"

if [ -z "${py:-}" ]; then
  echo "pre-push: no interpreter found; run the checks yourself or --no-verify" >&2
  exit 1
fi

# git calls pre-push with the remote's name and URL as $1 and $2, and feeds the
# refs being pushed on stdin. The gate reads those refs with --pushed; the remote
# name and URL are not gate arguments.
echo "pre-push: running the CI steps locally. --no-verify skips this."
"$py" "$root/skills/seo-checklist/tools/ci_local.py" --pushed
